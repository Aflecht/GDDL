identifier ActionAttack u8
	melee_weapon	= "Standard attack done with a melee weapon"
	ranged_weapon	= "Standard attack done with a ranged weapon"

identifier Element u8
	fire		= "Elemental fire damage type"
	ice		= "Elemental ice damage type"
	lightning	= "Elemental lightning damage type"

define Creature
	hp     = u8
	attack = ActionAttack

Creature Goblin
	hp = 10
	attack = ActionAttack.melee_weapon

Creature Archer
	hp = 8
	attack = ActionAttack.ranged_weapon

define Object
	something1 = u8
	something2 = u8

define Item
	object  = Object
	weight  = u8
	element = Element

Item Sword
	object
		something1 = 5
		something2 = 3
	weight = 7
	element = Element.fire

Item Shield
	object
		something1 = 2
		something2 = 9
	weight = 4
	element = Element.ice
