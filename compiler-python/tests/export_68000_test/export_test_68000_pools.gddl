// Real vbcc/vamos compile-and-run validation for the pools feature on the
// 68000 export target (C89 via vbcc) -- stage 4's "real compiled/run
// output" requirement. See corpus/pools/ for the phase 1-8 golden-locked
// coverage; this fixture covers the export-side half those fixtures
// can't capture. Unlike 6502/Z80, the 68000 target has no field-type
// restriction on pool contents (real MULU/MULS instruction, real
// linker) -- deliberately mixes scalar, array, string, and nested-struct
// fields, matching the C++ target's own pools fixture, to demonstrate
// that full range working end to end here too.
//
// One named instance is included deliberately -- a type with ZERO named
// instances hits a real, pre-existing, unrelated vbcc gap
// (`Type_Instances[0] = {}` is an empty initializer, vbcc error 360),
// already honestly recorded in HANDOFF.md from this feature's own stage
// 3 work; this fixture works around it the same way, rather than
// re-triggering an already-known, out-of-scope bug.

define Vec2
	x = i32
	y = i32

define Enemy
	hp = i32
	damage_min_max = i32 : 2
	name = string 16
	position = Vec2

Enemy Placeholder
	hp = 1
	damage_min_max = 0, 0
	name = "x"
	position
		x = 0
		y = 0

pool Enemy ActiveEnemies : 8
