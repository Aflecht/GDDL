// Fixture: arrays_1d_literal_valid
// Rule under test: arrays design (HANDOFF.md "Arrays work" stages 1-3) --
// a 1D array value literal, with and without the always-optional single
// outermost brace layer -- both forms produce the identical resolved value.

define Enemy
	damage_min_max = i32 : 2

Enemy Goblin
	damage_min_max = 10, 30

Enemy GoblinBraced
	damage_min_max = { 10, 30 }

// Expected: compiles cleanly, no error.
//   Goblin.damage_min_max        == [10, 30]
//   GoblinBraced.damage_min_max  == [10, 30]  (identical -- outermost braces
//                                              are always optional, never
//                                              change meaning)
